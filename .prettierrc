{
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "trailingComma": "all",
  "arrowParens": "avoid",
  "singleQuote": false,
  "printWidth": 120,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "",
    "^\\.\\.?/",
    "",
    ".s?css$"
  ]
}
